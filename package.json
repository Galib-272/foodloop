{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:parity": "npx -y tsx scripts/parity.ts",
    "vercel-build": "tsx scripts/init-db.ts && next build",
    "db:init": "tsx scripts/init-db.ts",
    "warehouse": "node scripts/py.mjs ml/warehouse/build_warehouse.py",
    "py:setup": "node scripts/py.mjs --setup",
    "rag:ingest": "node scripts/py.mjs rag/build_knowledge.py && node scripts/py.mjs rag/ingest.py && node scripts/py.mjs rag/build_graph.py",
    "rag:ask": "node scripts/py.mjs rag/agent.py",
    "rag:eval": "node scripts/py.mjs rag/eval.py",
    "rag:all": "npm run rag:ingest && npm run rag:eval && npm run docs:metrics",
    "rag:publish": "sh scripts/rag-publish.sh",
    "test:rag": "npx -y tsx scripts/rag-parity.ts",
    "n8n": "node automation/n8n/start.mjs",
    "lakehouse": "node scripts/py.mjs ml/lakehouse/build_lakehouse.py",
    "mcp:forecast": "tsx mcp/forecast-server.ts",
    "mcp:knowledge": "tsx mcp/knowledge-server.ts",
    "mcp:warehouse": "tsx mcp/warehouse-server.ts",
    "test:mcp": "tsx scripts/mcp-test.ts",
    "typecheck:mcp": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc -p mcp/tsconfig.json",
    "docs:metrics": "node scripts/docs-metrics.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@types/node": "20.6.2",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "autoprefixer": "10.4.15",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "eslint": "8.49.0",
    "eslint-config-next": "13.5.1",
    "framer-motion": "11.18.2",
    "libsql": "^0.5.29",
    "lucide-react": "^0.446.0",
    "next": "13.5.1",
    "postcss": "8.4.30",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsx": "4.19.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
